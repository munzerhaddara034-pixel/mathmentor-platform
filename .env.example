# Environment — never commit real secrets

# Interactive avatar (HeyGen). Leave empty for local demo (Munzer still + silent timeline).
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_TALKING_PHOTO_ID=
HEYGEN_VOICE_ID=
HEYGEN_VOICE_ID_AR=
HEYGEN_VOICE_ID_EN=

# AI script generator. If unset, POST /api/studio/script returns a deterministic four-phase template.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional alias used if OPENAI_API_KEY is empty:
LLM_API_KEY=

# Optional future GeoGebra hook (not required; SVG plotter is the default).
NEXT_PUBLIC_GEOGEBRA_APP_NAME=graphing
NEXT_PUBLIC_GEOGEBRA_MATERIAL_ID=

# Existing protected-video providers (classroom watermark player)
NEXT_PUBLIC_VIDEO_PROVIDER=local
NEXT_PUBLIC_BUNNY_LIBRARY_ID=
NEXT_PUBLIC_VIMEO_OTT_URL=
NEXT_PUBLIC_WISTIA_ID=
