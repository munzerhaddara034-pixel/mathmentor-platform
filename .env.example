# Environment — never commit real secrets

# Interactive avatar (HeyGen). Leave empty for local demo (Munzer still + silent timeline / placeholder mp4).
# Server-side only — never expose HEYGEN_API_KEY to the browser.
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_TALKING_PHOTO_ID=
HEYGEN_VOICE_ID=
HEYGEN_VOICE_ID_AR=
HEYGEN_VOICE_ID_EN=
HEYGEN_VOICE_ID_FR=
# Optional extra lock for POST /api/heygen/generate (staff session is already required).
HEYGEN_ADMIN_TOKEN=
# Optional webhook verification for POST /api/heygen/webhook
HEYGEN_WEBHOOK_SECRET=
# Public origin used as HeyGen callback_url → {NEXT_PUBLIC_APP_URL}/api/heygen/webhook
NEXT_PUBLIC_APP_URL=

# AI script / solver. If unset, POST /api/studio/script and POST /api/solve-math use deterministic templates.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional alias used if OPENAI_API_KEY is empty:
LLM_API_KEY=

# Gemini (text + Vision for notebook photos). Leave empty for the Lebanese demo solver.
GEMINI_API_KEY=
# Optional: GOOGLE_API_KEY is accepted as an alias for Gemini.
# GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Live 1-on-1 meeting links. Without keys the book API issues a Google Meet-style stub
# (https://meet.google.com/xxx-xxxx-xxx). If ZOOM_ACCOUNT_ID is set without OAuth, a
# zoom.us/j/ stub is used. Full Zoom Server-to-Server OAuth creates a real meeting.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Optional Meet template: https://meet.google.com/{code}  (placeholders {id} and {code})
GOOGLE_MEET_LINK_TEMPLATE=

# WhatsApp (Twilio or UltraMsg). WHATSAPP_PROVIDER=twilio|ultramsg
# Without tokens, outbound messages are logged to data/whatsapp-outbox.json (admin-visible).
WHATSAPP_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
TEACHER_WHATSAPP=96176532421
# Cron: POST /api/jobs/whatsapp-reminders  (x-jobs-secret or Bearer). Empty JOBS_SECRET = demo allow.
JOBS_SECRET=

# Desmos Graphing Calculator API (required to plot with Desmos instead of the SVG fallback).
# Request a key: https://www.desmos.com/api/v1.8/docs/index.html
# Script loaded: https://www.desmos.com/api/v1.8/calculator.js?apiKey=...
NEXT_PUBLIC_DESMOS_API_KEY=


# Existing protected-video providers (classroom watermark player)
NEXT_PUBLIC_VIDEO_PROVIDER=local
NEXT_PUBLIC_BUNNY_LIBRARY_ID=
NEXT_PUBLIC_VIMEO_OTT_URL=
NEXT_PUBLIC_WISTIA_ID=

# File stores: local `data/` or `/tmp/mathmentor-data` on Netlify/Lambda. Demo accounts: see docs/AUTH.md
# Cookie Secure follows HTTPS / x-forwarded-proto. Override: AUTH_COOKIE_SECURE=0|1
# AUTH_COOKIE_SECURE=
