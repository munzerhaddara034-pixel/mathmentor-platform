# Environment — never commit real secrets

# Interactive avatar (HeyGen). Leave empty for local demo (Munzer still + silent timeline / placeholder mp4).
# Server-side only — never expose HEYGEN_API_KEY to the browser.
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_TALKING_PHOTO_ID=
HEYGEN_VOICE_ID=
HEYGEN_VOICE_ID_AR=
HEYGEN_VOICE_ID_EN=
HEYGEN_VOICE_ID_FR=
# Optional extra lock for POST /api/heygen/generate (staff session is already required).
HEYGEN_ADMIN_TOKEN=
# Optional webhook verification for POST /api/heygen/webhook
HEYGEN_WEBHOOK_SECRET=
# Public origin used as HeyGen callback_url → {NEXT_PUBLIC_APP_URL}/api/heygen/webhook
NEXT_PUBLIC_APP_URL=

# AI script / solver. If unset, POST /api/studio/script and POST /api/solve-math use deterministic templates.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Whisper speech-to-text for POST /api/voice-math (model whisper-1). Same key as above.
# Without OPENAI_API_KEY the voice studio accepts a sample Arabic/English dictation stub.
# Optional GPT-4o speech-to-LaTeX model (defaults to gpt-4o when Gemini is absent):
# OPENAI_VOICE_MODEL=gpt-4o
# Optional alias used if OPENAI_API_KEY is empty:
LLM_API_KEY=

# Gemini (text + Vision for notebook photos). Leave empty for the Lebanese demo solver.
# Voice-to-LaTeX prefers Gemini 1.5 Pro, then falls back to flash / GPT-4o / demo.
GEMINI_API_KEY=
# Optional: GOOGLE_API_KEY is accepted as an alias for Gemini.
# GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional pin for the voice parser (tried first):
# GEMINI_VOICE_MODEL=gemini-1.5-pro

# Live 1-on-1 meeting links. Without keys the book API issues a Google Meet-style stub
# (https://meet.google.com/xxx-xxxx-xxx). If ZOOM_ACCOUNT_ID is set without OAuth, a
# zoom.us/j/ stub is used. Full Zoom Server-to-Server OAuth creates a real meeting.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Optional Meet template: https://meet.google.com/{code}  (placeholders {id} and {code})
GOOGLE_MEET_LINK_TEMPLATE=

# WhatsApp (Twilio, UltraMsg, or Meta Cloud API). WHATSAPP_PROVIDER=twilio|ultramsg|meta
# Without tokens, outbound messages are logged to data/whatsapp-outbox.json (admin-visible).
WHATSAPP_PROVIDER=ultramsg
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
TEACHER_WHATSAPP=96170772968
# Fallback when TEACHER_WHATSAPP empty: 96170772968
# Whish / payment / booking notify phone stays 96170772968 باسم منذر أحمد حداره — do NOT change for agent allowlist.

# Agent Hub WhatsApp voice allowlist (instructor only — NOT the Whish wallet).
# Accepts: 76532421 | 076532421 | 96176532421 | +96176532421 | 0096176532421
INSTRUCTOR_WHATSAPP_NUMBER=96176532421

# Meta Cloud API (optional). WHATSAPP_PROVIDER=meta|ultramsg|twilio
# Webhook URL: https://mathmentor-munzer.netlify.app/api/agent/whatsapp-voice
WHATSAPP_VERIFY_TOKEN=mathmentor_secret_token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta webhook at /api/whatsapp reads WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID (never hardcode them).
# Alias for WHATSAPP_ACCESS_TOKEN:
WHATSAPP_TOKEN=

# Cron: POST /api/jobs/whatsapp-reminders  (x-jobs-secret or Bearer). Empty JOBS_SECRET = demo allow.
JOBS_SECRET=

# Desmos Graphing Calculator API (required to plot with Desmos instead of the SVG fallback).
# Request a key: https://www.desmos.com/api/v1.8/docs/index.html
# Script loaded: https://www.desmos.com/api/v1.8/calculator.js?apiKey=...
NEXT_PUBLIC_DESMOS_API_KEY=


# Existing protected-video providers (classroom watermark player)
NEXT_PUBLIC_VIDEO_PROVIDER=local
# Per-lesson videos: set `videoUrl` on the lesson (YouTube link or /videos/file.mp4).
# These env vars are only a platform-wide fallback when a lesson has no videoUrl.
NEXT_PUBLIC_BUNNY_LIBRARY_ID=
NEXT_PUBLIC_VIMEO_OTT_URL=
NEXT_PUBLIC_WISTIA_ID=

# LiveKit Cloud — live tutoring + math whiteboard (`/live/classroom/[roomId]`).
# Leave empty for mock/shell mode: POST /api/livekit/token returns demo JSON and the UI still renders.
# Server secrets — never expose LIVEKIT_API_SECRET to the browser.
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-project.livekit.cloud

# File stores: local `data/` or `/tmp/mathmentor-data` on Netlify/Lambda. No demo accounts are seeded (docs/AUTH.md).

# Staff rights come ONLY from these allowlists (comma-separated, case-insensitive, trimmed).
# ADMIN_EMAILS: these emails get the admin (teacher + admin) role at signup, and again at login if
# the account already exists. Every other signup is a student (or parent). If unset/blank, the
# documented fallback is munzerhaddara2@gmail.com. Signup does NOT verify email ownership yet:
# register each listed address yourself right after deploying.
ADMIN_EMAILS=munzerhaddara2@gmail.com
# TEAM_APPROVER_EMAILS: who may click «موافقة ونشر» in /admin/team. Unset/blank = ADMIN_EMAILS.
TEAM_APPROVER_EMAILS=
# Cookie Secure follows HTTPS / x-forwarded-proto. Override: AUTH_COOKIE_SECURE=0|1
# AUTH_COOKIE_SECURE=

# Whish Money — MANUAL transfer for ALL payments: subscriptions + live (no merchant API).
# Students transfer to WHISH_TRANSFER_PHONE; orders/bookings stay pending_payment until marked paid.
# See docs/WHISH.md. WhatsApp is support-only — never a payment CTA.
WHISH_ENABLED=1
WHISH_TRANSFER_PHONE=96170772968
WHISH_TRANSFER_NAME=منذر أحمد حداره
# Dual live Whish pricing (Munzer Ahmad Haddara / منذر أحمد حداره)
LIVE_SESSION_PRICE_USD=15
LIVE_SESSION_PRICE_EXTERNAL_USD=25
NEXT_PUBLIC_LIVE_SESSION_PRICE_USD=15
NEXT_PUBLIC_LIVE_SESSION_PRICE_EXTERNAL_USD=25
LIVE_SESSION_PRICE_LBP=
# Optional future merchant API (unused by the manual transfer flow):
WHISH_API_URL=https://whish.money/itel-service/api
WHISH_CHANNEL=
WHISH_SECRET=
WHISH_WEBSITEURL=

# Leave WHISH_CHANNEL / WHISH_SECRET / WHISH_WEBSITEURL empty for demo checkout
# (/live/pay/demo?booking=...). Never invent or commit real merchant secrets.
# Headers (community whish-pay pattern — confirm with your Whish merchant docs):
#   Content-Type: application/json
#   channel / secret / websiteurl
WHISH_ENABLED=1
WHISH_API_URL=https://whish.money/itel-service/api
WHISH_CHANNEL=
WHISH_SECRET=
WHISH_WEBSITEURL=
LIVE_SESSION_PRICE_USD=15
LIVE_SESSION_PRICE_EXTERNAL_USD=25
NEXT_PUBLIC_LIVE_SESSION_PRICE_USD=15
NEXT_PUBLIC_LIVE_SESSION_PRICE_EXTERNAL_USD=25
LIVE_SESSION_PRICE_LBP=


# Autonomous Ops Agent (WhatsApp voice webhook + marketing completion)
# Staff session OR this shared secret (also accepts JOBS_SECRET / ULTRAMSG_TOKEN).
# Meta GET verify uses WHATSAPP_VERIFY_TOKEN; inbound webhooks are phone-allowlisted to INSTRUCTOR_WHATSAPP_NUMBER.
AGENT_WEBHOOK_SECRET=

# Western Union / OMT — MANUAL transfer beneficiaries (no auto-API).
# Used on /subscribe for GCC & international (Whish remains available).
# Beneficiary defaults to منذر أحمد حداره / Munzer Ahmad Haddara when empty.
WU_BENEFICIARY_NAME_AR=منذر أحمد حداره
WU_BENEFICIARY_NAME_EN=Munzer Ahmad Haddara
WU_BENEFICIARY_COUNTRY=Lebanon
WU_BENEFICIARY_CITY=Beirut
WU_BENEFICIARY_PHONE=
OMT_BENEFICIARY_NAME_AR=منذر أحمد حداره
OMT_BENEFICIARY_NAME_EN=Munzer Ahmad Haddara
OMT_BENEFICIARY_PHONE=
OMT_LOCATION_HINT=أي فرع OMT في لبنان / Any OMT branch in Lebanon

# Agent code-evolution commits (after instructor approval only)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=mathmentor-platform
GITHUB_BRANCH=main

# Code-evolution agent (/api/bot, /api/agent/whatsapp-voice/gemini) commits via GITHUB_TOKEN to GITHUB_BRANCH.
# Server-only. Requires a staff session or AGENT_WEBHOOK_SECRET before any commit is attempted.

# ── Security hardening (docs/SECURITY_HARDENING.md) ─────────────────────────────
# E-mail verification for new signups (required: new accounts, incl. ADMIN_EMAILS, stay locked
# until the emailed link is opened + password entered). Existing accounts are grandfathered.
# Resend (https://resend.com): API key + a sender on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Public origin used in the confirmation link (falls back to NEXT_PUBLIC_APP_URL, then the request origin).
APP_BASE_URL=
# Bootstrap only: write confirmation links to the server log when no provider is configured.
# Anyone with log access can read them — unset once RESEND_API_KEY works.
EMAIL_DEV_LOG_LINKS=
# Meta app secret: when set, /api/whatsapp and /api/agent/whatsapp-voice reject unsigned
# (X-Hub-Signature-256) Meta webhook payloads.
WHATSAPP_APP_SECRET=
# Agent APIs refuse anonymous "demo" mode in production unless this is 1 (not recommended).
AGENT_ALLOW_DEMO_MODE=
