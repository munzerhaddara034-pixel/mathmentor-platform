# Copy this file to `.env.local` and fill in values you need.
# The app starts without these: AI chat falls back to local answers,
# and classroom video stays on the built-in local player.

# Optional. Used by /api/bot for student chat. If unset, replies come from the local knowledge base.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini when OPENAI_API_KEY is set.
OPENAI_MODEL=gpt-4o-mini

# Video delivery. Default is the local Classroom Studio player (watermark only, no OTT DRM).
# Allowed values: local | bunny | vimeo-ott | wistia
NEXT_PUBLIC_VIDEO_PROVIDER=local

# Bunny Stream library id (used when NEXT_PUBLIC_VIDEO_PROVIDER=bunny)
NEXT_PUBLIC_BUNNY_LIBRARY_ID=

# Vimeo OTT embed URL (used when NEXT_PUBLIC_VIDEO_PROVIDER=vimeo-ott)
NEXT_PUBLIC_VIMEO_OTT_URL=

# Wistia hashed id (used when NEXT_PUBLIC_VIDEO_PROVIDER=wistia)
NEXT_PUBLIC_WISTIA_ID=
