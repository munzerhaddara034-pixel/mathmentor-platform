{
  "name": "mathmentor-platform",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "banks:g12": "python3 scripts/build-g12-banks.py",
    "video:limits": "python3 scripts/render-lesson-video.py content/grade-12-ls-limits/intro-video.json public/videos/grade-12-ls-limits-intro.mp4 --lang ar",
    "video:continuity": "python3 scripts/render-lesson-video.py content/lessons/grade-12-ls-continuity/video.json --both",
    "video:derivatives": "python3 scripts/render-lesson-video.py content/lessons/grade-12-ls-derivatives/video.json --both",
    "video:brevet-geometry": "python3 scripts/render-lesson-video.py content/lessons/brevet-geometry-thales/video.json --both",
    "video:lessons": "npm run video:continuity && npm run video:derivatives && npm run video:brevet-geometry"
  },
  "dependencies": {
    "@octokit/rest": "^20.0.0",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "pdf-parse": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  }
}
